{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket"
      ],
      "Resource": [
        "*",
        "arn:aws:s3:::secure-data-pipeline-bucket-fuzailm"
      ]
    },
    {
      "Sid": "AllowReadOnlyObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::secure-data-pipeline-bucket-fuzailm/*"
      ]
    }
  ]
}
